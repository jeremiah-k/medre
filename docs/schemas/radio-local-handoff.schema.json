{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medre.dev/schemas/radio-local-handoff.schema.json",
  "title": "Synchronous radio local handoff reference",
  "description": "Decoded JSON from a guarded-dispatch accepted part handoff_id. Native scope is retained and null IDs remain null; this is not whole-message relation authority or proof of recipient delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ordinal",
    "native_message_id",
    "native_channel_id",
    "confirmation_level"
  ],
  "properties": {
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "native_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_channel_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmation_level": {
      "enum": [
        "unknown",
        "local_queue",
        "local_transport",
        "remote_service",
        "end_to_end"
      ]
    }
  }
}
