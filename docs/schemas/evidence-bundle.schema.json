{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medre.dev/schemas/evidence-bundle.schema.json",
  "title": "EvidenceBundle",
  "description": "JSON-safe evidence bundle returned by collect_evidence_bundle(). Contains schema_version, status, sections, errors, and limitations.",
  "type": "object",
  "properties": {
    "adapter_status": {
      "description": "Per-adapter runtime status evidence extracted from diagnostics, or null.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/AdapterStatusEvidence" }
        }
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when collection started."
    },
    "command": {
      "type": "string",
      "enum": ["evidence"],
      "description": "Command that produced this bundle. Always 'evidence'."
    },
    "config_source": {
      "type": ["string", "null"],
      "description": "Config source identifier (e.g. 'file', 'env', 'default', 'none')."
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of error messages from sections that encountered errors."
    },
    "evidence_tier": {
      "type": "string",
      "enum": [
        "synthetic",
        "conformance",
        "docker",
        "live_service",
        "hardware"
      ],
      "description": "Evidence provenance tier describing how the evidence was produced. 'live_service' and 'hardware' require explicit opt-in; they are never auto-inferred."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when generation completed."
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known limitations of the evidence collection process."
    },
    "medre_version": {
      "type": "string",
      "description": "MEDRE package version string (e.g. '0.1.0')."
    },
    "runtime_started": {
      "type": "boolean",
      "description": "Whether the runtime was started to collect live health data."
    },
    "schema_version": {
      "type": "integer",
      "description": "Evidence bundle schema version. Currently 1.",
      "const": 1
    },
    "sections": {
      "type": "object",
      "description": "Collected evidence sections.",
      "properties": {
        "config_summary": {
          "$ref": "#/$defs/ConfigSummarySection"
        },
        "route_validation": {
          "$ref": "#/$defs/RouteValidationSection"
        },
        "diagnostics_snapshot": {
          "$ref": "#/$defs/DiagnosticsSnapshotSection"
        },
        "live_health": {
          "$ref": "#/$defs/LiveHealthSection"
        },
        "storage": {
          "$ref": "#/$defs/StorageEvidenceSection"
        },
        "recovery": {
          "$ref": "#/$defs/RecoveryEvidenceSection"
        }
      },
      "additionalProperties": false
    },
    "shutdown_evidence": {
      "description": "Runtime shutdown/cancellation evidence extracted from diagnostics, or null.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ShutdownEvidence" }]
    },
    "convergence_summary": {
      "description": "When collected with an event_id, event-scoped; without, the storage-wide global view. Derived from delivery receipts and outbox items. None when storage is absent/unavailable or no delivery data matches the query. When global results are partial due to the default 10 000-record query limit, the storage section data includes a convergence_truncated_warning string.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ConvergenceSummary" }]
    },
    "orphan_report": {
      "description": "When collected with an event_id, event-scoped; without, the storage-wide global view. Derived from delivery receipts and outbox items. None when storage is absent/unavailable or no delivery data matches the query.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/OrphanReport" }]
    },
    "recovery_summary": {
      "description": "Per-event recovery ownership summary derived from outbox state, or null.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/RecoverySummary" }]
    },
    "recovery_ledger": {
      "description": "Per-event startup recovery ledger with ownership actions, or null.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/StartupRecoveryLedger" }]
    },
    "lifecycle_convergence_report": {
      "description": "When collected with an event_id, event-scoped; without, the storage-wide global view. Lifecycle delivery convergence findings (receipt/outbox mismatches, retry anomalies, stalled plans). None when storage is absent/unavailable or no delivery data matches the query.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/LifecycleConvergenceReport" }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "partial", "error"],
      "description": "Overall evidence collection status."
    }
  },
  "required": [
    "adapter_status",
    "collected_at",
    "command",
    "config_source",
    "convergence_summary",
    "errors",
    "evidence_tier",
    "generated_at",
    "lifecycle_convergence_report",
    "limitations",
    "medre_version",
    "orphan_report",
    "recovery_ledger",
    "recovery_summary",
    "runtime_started",
    "schema_version",
    "sections",
    "shutdown_evidence",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "AdapterStatusEvidence": {
      "title": "AdapterStatusEvidence",
      "description": "JSON-safe evidence for a single adapter's runtime status.",
      "type": "object",
      "properties": {
        "adapter_id": {
          "type": "string",
          "description": "Unique adapter identifier."
        },
        "adapter_kind": {
          "type": ["string", "null"],
          "description": "Adapter kind: 'real', 'fake', or null."
        },
        "configured": {
          "type": ["boolean", "null"],
          "description": "Whether transport configuration is present."
        },
        "connected": {
          "type": ["boolean", "null"],
          "description": "True if connected, False if definitely not, null if indeterminate."
        },
        "current_state": {
          "type": ["string", "null"],
          "description": "Lifecycle state value string (e.g. 'ready'), or null."
        },
        "enabled": {
          "type": ["boolean", "null"],
          "description": "Whether the adapter is enabled in config."
        },
        "failure_category": {
          "type": ["string", "null"],
          "description": "Caller-supplied failure category, or null."
        },
        "failure_reason": {
          "type": ["string", "null"],
          "description": "Caller-supplied failure reason, or null."
        },
        "health": {
          "type": ["string", "null"],
          "description": "Normalised health string, or null."
        },
        "operator_status": {
          "type": "string",
          "enum": [
            "disabled",
            "not_configured",
            "configured",
            "starting",
            "connected",
            "degraded",
            "unavailable",
            "stopping",
            "failed",
            "stopped"
          ],
          "description": "Normalised operator-facing status string."
        },
        "transport": {
          "type": ["string", "null"],
          "description": "Transport type (e.g. 'matrix', 'meshtastic'), or null."
        },
        "valid_transitions": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Sorted list of valid target state strings, or null."
        }
      },
      "required": [
        "adapter_id",
        "adapter_kind",
        "configured",
        "connected",
        "current_state",
        "enabled",
        "failure_category",
        "failure_reason",
        "health",
        "operator_status",
        "transport",
        "valid_transitions"
      ],
      "additionalProperties": false
    },
    "ShutdownEvidence": {
      "title": "ShutdownEvidence",
      "description": "Immutable shutdown evidence record with deterministic key ordering.",
      "type": "object",
      "properties": {
        "drain_timeout_detected": {
          "type": "boolean",
          "description": "Whether drain timeout was detected from events or reason."
        },
        "evidence_flush_status": {
          "type": ["string", "null"],
          "description": "Status of evidence persistence at shutdown (e.g. 'flushed', 'partial')."
        },
        "in_flight_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of in-flight deliveries from capacity controller."
        },
        "outbox_shutdown_policy": {
          "type": ["string", "null"],
          "description": "Outbox shutdown policy name. 'resumable' when outbox_counts were supplied; null when no outbox data."
        },
        "pending_outbox_counts": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          ],
          "description": "Outbox counts filtered to pending statuses, or null."
        },
        "pending_retry_work_total": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Total count of pending retry work items."
        },
        "resume_expected": {
          "type": "boolean",
          "description": "Whether pending outbox work is expected to resume on next start. True when non-terminal outbox work exists and runtime is stopped/stopping."
        },
        "retry_worker_dead_lettered": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of retry items that were dead-lettered."
        },
        "retry_worker_failed": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of retry items that failed."
        },
        "retry_worker_processed": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Total retry items processed."
        },
        "retry_worker_running": {
          "type": ["boolean", "null"],
          "description": "Whether the retry worker was running at shutdown."
        },
        "retry_worker_succeeded": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of retry items that succeeded."
        },
        "runtime_state": {
          "type": ["string", "null"],
          "description": "Runtime lifecycle state value string at shutdown."
        },
        "shutdown_reason": {
          "type": ["string", "null"],
          "description": "Deterministic shutdown reason string, or null."
        },
        "shutdown_status": {
          "type": "string",
          "enum": [
            "running",
            "graceful_stop",
            "cancellation",
            "adapter_failure",
            "drain_timeout",
            "shutdown_pending",
            "stopped",
            "failed"
          ],
          "description": "Canonical shutdown status classification."
        },
        "tasks_cancelled": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Number of tasks cancelled during shutdown, or null."
        }
      },
      "required": [
        "drain_timeout_detected",
        "evidence_flush_status",
        "in_flight_count",
        "outbox_shutdown_policy",
        "pending_outbox_counts",
        "pending_retry_work_total",
        "resume_expected",
        "retry_worker_dead_lettered",
        "retry_worker_failed",
        "retry_worker_processed",
        "retry_worker_running",
        "retry_worker_succeeded",
        "runtime_state",
        "shutdown_reason",
        "shutdown_status",
        "tasks_cancelled"
      ],
      "additionalProperties": false
    },
    "EvidenceSection": {
      "title": "EvidenceSection",
      "description": "Strict status envelope shared by all evidence sections. Successful sections carry object data; error/skipped sections carry null data; partial sections may retain partial object data or null.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "partial", "error", "skipped"],
          "description": "Section collection status."
        },
        "error": {
          "type": ["string", "null"],
          "description": "Sanitised error text for partial/error sections; null otherwise."
        },
        "data": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ],
          "description": "Section payload object, or null when unavailable."
        },
        "note": {
          "type": "string",
          "description": "Required skip reason for skipped sections."
        }
      },
      "required": ["status", "error", "data"],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "passed"
            },
            "error": {
              "type": "null"
            },
            "data": {
              "type": "object"
            }
          },
          "not": {
            "required": ["note"]
          }
        },
        {
          "properties": {
            "status": {
              "const": "partial"
            },
            "error": {
              "type": "string"
            }
          },
          "not": {
            "required": ["note"]
          }
        },
        {
          "properties": {
            "status": {
              "const": "error"
            },
            "error": {
              "type": "string"
            },
            "data": {
              "type": "null"
            }
          },
          "not": {
            "required": ["note"]
          }
        },
        {
          "properties": {
            "status": {
              "const": "skipped"
            },
            "error": {
              "type": "null"
            },
            "data": {
              "type": "null"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["note"]
        }
      ]
    },
    "ConfigSummarySection": {
      "title": "ConfigSummarySection",
      "allOf": [
        {
          "$ref": "#/$defs/EvidenceSection"
        },
        {
          "properties": {
            "data": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/ConfigSummaryData"
                }
              ]
            }
          }
        }
      ]
    },
    "RouteValidationSection": {
      "title": "RouteValidationSection",
      "allOf": [
        {
          "$ref": "#/$defs/EvidenceSection"
        },
        {
          "properties": {
            "data": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/RouteValidationData"
                }
              ]
            }
          }
        }
      ]
    },
    "DiagnosticsSnapshotSection": {
      "title": "DiagnosticsSnapshotSection",
      "allOf": [
        {
          "$ref": "#/$defs/EvidenceSection"
        },
        {
          "properties": {
            "data": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object"
                }
              ]
            }
          }
        }
      ]
    },
    "LiveHealthSection": {
      "title": "LiveHealthSection",
      "allOf": [
        {
          "$ref": "#/$defs/EvidenceSection"
        },
        {
          "properties": {
            "data": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object"
                }
              ]
            }
          }
        }
      ]
    },
    "StorageEvidenceSection": {
      "title": "StorageEvidenceSection",
      "allOf": [
        {
          "$ref": "#/$defs/EvidenceSection"
        },
        {
          "properties": {
            "data": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/StorageEvidenceData"
                }
              ]
            }
          }
        }
      ]
    },
    "RecoveryEvidenceSection": {
      "title": "RecoveryEvidenceSection",
      "allOf": [
        {
          "$ref": "#/$defs/EvidenceSection"
        },
        {
          "properties": {
            "data": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/RecoveryEvidenceData"
                }
              ]
            }
          }
        }
      ]
    },
    "ConfigSummaryData": {
      "title": "ConfigSummaryData",
      "type": "object",
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "adapter_id": {
                "type": "string"
              },
              "adapter_kind": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "transport": {
                "type": "string"
              }
            },
            "required": ["adapter_id", "adapter_kind", "enabled", "transport"],
            "additionalProperties": false
          }
        },
        "env_overrides_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "delivery_acquire_timeout_seconds": {
              "type": "number",
              "minimum": 0
            },
            "max_inflight_deliveries": {
              "type": "integer",
              "minimum": 1
            },
            "max_inflight_replay_events": {
              "type": "integer",
              "minimum": 1
            },
            "shutdown_drain_timeout_seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "logging_level": {
          "type": "string"
        },
        "paths": {
          "type": "object",
          "properties": {
            "config_dir": {
              "type": "string"
            },
            "config_file": {
              "type": "string"
            },
            "state_dir": {
              "type": "string"
            },
            "data_dir": {
              "type": "string"
            },
            "cache_dir": {
              "type": "string"
            },
            "log_dir": {
              "type": "string"
            },
            "database_path": {
              "type": "string"
            },
            "adapter_state_root": {
              "type": "string"
            }
          },
          "required": [
            "config_dir",
            "config_file",
            "state_dir",
            "data_dir",
            "cache_dir",
            "log_dir",
            "database_path",
            "adapter_state_root"
          ],
          "additionalProperties": false
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dest_adapters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "directionality": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "route_id": {
                "type": "string"
              },
              "source_adapters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "dest_adapters",
              "directionality",
              "enabled",
              "route_id",
              "source_adapters"
            ],
            "additionalProperties": false
          }
        },
        "runtime_name": {
          "type": "string"
        },
        "storage_backend": {
          "type": "string"
        },
        "storage_path": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "adapters",
        "env_overrides_applied",
        "limits",
        "logging_level",
        "paths",
        "routes",
        "runtime_name",
        "storage_backend",
        "storage_path"
      ],
      "additionalProperties": false
    },
    "RouteValidationData": {
      "title": "RouteValidationData",
      "type": "object",
      "properties": {
        "route_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_enabled": {
          "type": "integer",
          "minimum": 0
        },
        "route_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "route_count",
        "route_enabled",
        "route_errors",
        "route_warnings",
        "valid"
      ],
      "additionalProperties": false
    },
    "StorageEvidenceData": {
      "title": "StorageEvidenceData",
      "description": "Stable top-level machine shape of sections.storage.data. Nested event/timeline/report payloads retain their own contracts.",
      "type": "object",
      "properties": {
        "db_exists": {
          "type": "boolean"
        },
        "db_path": {
          "type": "string"
        },
        "event": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "event_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "incident_summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "native_refs_for_event": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array"
            }
          ]
        },
        "receipt_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "delivery_observation_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "delivery_observations_for_event": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array"
            }
          ]
        },
        "replay_run_receipts": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array"
            }
          ]
        },
        "timeline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array"
            }
          ]
        },
        "replay_timeline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array"
            }
          ]
        },
        "delivery_outcome_ledger": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "retry_outbox_summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "lifecycle_convergence_report": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/LifecycleConvergenceReport"
            }
          ]
        },
        "convergence_summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ConvergenceSummary"
            }
          ]
        },
        "orphan_report": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/OrphanReport"
            }
          ]
        },
        "convergence_truncated_warning": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "db_exists",
        "db_path",
        "event",
        "event_count",
        "incident_summary",
        "native_refs_for_event",
        "receipt_count",
        "delivery_observation_count",
        "delivery_observations_for_event",
        "replay_run_receipts",
        "timeline",
        "replay_timeline",
        "delivery_outcome_ledger",
        "retry_outbox_summary",
        "lifecycle_convergence_report",
        "convergence_summary",
        "orphan_report",
        "convergence_truncated_warning"
      ],
      "additionalProperties": false
    },
    "RecoveryEvidenceData": {
      "title": "RecoveryEvidenceData",
      "type": "object",
      "properties": {
        "recovery_summary": {
          "$ref": "#/$defs/RecoverySummary"
        },
        "recovery_ledger": {
          "$ref": "#/$defs/StartupRecoveryLedger"
        },
        "snapshot_context": {
          "type": "object",
          "properties": {
            "source": {
              "const": "storage_snapshot"
            },
            "collection_timestamp": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": ["source", "collection_timestamp"],
          "additionalProperties": false
        }
      },
      "required": ["recovery_summary", "recovery_ledger", "snapshot_context"],
      "additionalProperties": false
    },
    "ConvergenceSummary": {
      "title": "ConvergenceSummary",
      "description": "Aggregate convergence summary. When collected with an event_id, scoped to that event's delivery targets; without, a storage-wide global summary across all targets. Null when storage is absent/unavailable or no delivery data matches.",
      "type": "object",
      "properties": {
        "evidence_bundle_ref": {
          "type": ["string", "null"],
          "description": "Reserved cross-reference to the evidence bundle. Currently null."
        },
        "orphan_count": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Count of orphan records. Null in convergence_summary; orphan_report is the authoritative source."
        },
        "severity_counts": {
          "type": "object",
          "properties": {
            "safe": { "type": "integer", "minimum": 0 },
            "degraded": { "type": "integer", "minimum": 0 },
            "inconsistent": { "type": "integer", "minimum": 0 }
          },
          "required": ["safe", "degraded", "inconsistent"],
          "additionalProperties": false,
          "description": "Count of targets per severity level (safe, degraded, inconsistent)."
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/DeliveryTargetConvergence" },
          "description": "Per-target convergence results, deterministically sorted by group key."
        },
        "total_targets": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of unique delivery targets examined."
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Aggregate diagnostic messages."
        },
        "worst_severity": {
          "type": ["string", "null"],
          "enum": ["safe", "degraded", "inconsistent", null],
          "description": "The worst convergence severity across all targets, or null if no targets."
        }
      },
      "required": [
        "evidence_bundle_ref",
        "orphan_count",
        "severity_counts",
        "targets",
        "total_targets",
        "warnings",
        "worst_severity"
      ],
      "additionalProperties": false
    },
    "DeliveryTargetConvergence": {
      "title": "DeliveryTargetConvergence",
      "description": "Convergence state for a single delivery target.",
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "description": "Canonical event grouping key. Empty string when absent."
        },
        "delivery_plan_id": {
          "type": "string",
          "description": "Delivery plan grouping key. Empty string when absent."
        },
        "target_adapter": {
          "type": "string",
          "description": "Adapter name."
        },
        "target_channel": {
          "type": ["string", "null"],
          "description": "Channel identifier or null."
        },
        "outbox_status": {
          "type": ["string", "null"],
          "description": "Status of the outbox item, or null if no outbox item."
        },
        "latest_receipt_status": {
          "type": ["string", "null"],
          "description": "Status of the current lifecycle-authoritative receipt, or null if no current receipt."
        },
        "latest_receipt_id": {
          "type": ["string", "null"],
          "description": "Receipt ID of the current lifecycle-authoritative receipt, or null."
        },
        "latest_attempt_number": {
          "type": ["integer", "null"],
          "description": "Attempt number from the current lifecycle-authoritative receipt, or null."
        },
        "severity": {
          "type": "string",
          "enum": ["safe", "degraded", "inconsistent"],
          "description": "Convergence severity classification."
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Diagnostic messages explaining the classification."
        },
        "outbox_id": {
          "type": ["string", "null"],
          "description": "Outbox item ID, or null."
        }
      },
      "required": [
        "event_id",
        "delivery_plan_id",
        "target_adapter",
        "target_channel",
        "outbox_status",
        "latest_receipt_status",
        "latest_receipt_id",
        "latest_attempt_number",
        "severity",
        "warnings",
        "outbox_id"
      ],
      "additionalProperties": false
    },
    "OrphanFinding": {
      "title": "OrphanFinding",
      "description": "A single orphan or invalid-lineage finding.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "orphaned_outbox",
            "orphaned_parent_receipt",
            "cross_plan_parent",
            "cross_event_parent",
            "missing_delivery_plan_id",
            "dead_lettered_retryable_mismatch",
            "recovered_not_progressed",
            "repeatedly_reclaimed",
            "reclaimed_then_terminal",
            "reclaimed_then_orphaned"
          ],
          "description": "Category of finding."
        },
        "severity": {
          "type": "string",
          "enum": ["inconsistent", "degraded"],
          "description": "Convergence severity string."
        },
        "record_id": {
          "type": "string",
          "description": "Identifier of the affected record (outbox_id or receipt_id)."
        },
        "record_type": {
          "type": "string",
          "enum": ["outbox", "receipt"],
          "description": "Type of the affected record."
        },
        "details": {
          "type": "string",
          "description": "Human-readable diagnostic message."
        },
        "extra": {
          "type": "object",
          "description": "Additional JSON-safe context (event IDs, plan IDs, statuses).",
          "additionalProperties": true
        }
      },
      "required": [
        "kind",
        "severity",
        "record_id",
        "record_type",
        "details",
        "extra"
      ],
      "additionalProperties": false
    },
    "OrphanReport": {
      "title": "OrphanReport",
      "description": "Aggregate orphan/invalid-lineage report.",
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/OrphanFinding" },
          "description": "Individual findings, deterministically sorted."
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of findings."
        },
        "severity_counts": {
          "type": "object",
          "properties": {
            "safe": { "type": "integer", "minimum": 0 },
            "degraded": { "type": "integer", "minimum": 0 },
            "inconsistent": { "type": "integer", "minimum": 0 }
          },
          "required": ["safe", "degraded", "inconsistent"],
          "additionalProperties": false,
          "description": "Count of findings per severity level."
        },
        "worst_severity": {
          "type": ["string", "null"],
          "enum": ["safe", "degraded", "inconsistent", null],
          "description": "Worst severity among findings, or null if empty."
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary line."
        }
      },
      "required": [
        "findings",
        "total_findings",
        "severity_counts",
        "worst_severity",
        "summary"
      ],
      "additionalProperties": false
    },
    "RecoverySummary": {
      "title": "RecoverySummary",
      "description": "Deterministic recovery ownership summary with consistency validation.",
      "type": "object",
      "properties": {
        "recoverable_items": { "type": "integer", "minimum": 0 },
        "claimed_items": { "type": "integer", "minimum": 0 },
        "reclaimed_items": { "type": "integer", "minimum": 0 },
        "skipped_items": { "type": "integer", "minimum": 0 },
        "abandoned_items": { "type": "integer", "minimum": 0 },
        "unrecoverable_items": { "type": "integer", "minimum": 0 },
        "total_items": { "type": "integer", "minimum": 0 },
        "consistency_valid": { "type": "boolean" },
        "by_source": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "recovery_run_id": { "type": ["string", "null"] }
      },
      "required": [
        "recoverable_items",
        "claimed_items",
        "reclaimed_items",
        "skipped_items",
        "abandoned_items",
        "unrecoverable_items",
        "total_items",
        "consistency_valid",
        "by_source",
        "recovery_run_id"
      ],
      "additionalProperties": false
    },
    "StartupRecoveryLedger": {
      "title": "StartupRecoveryLedger",
      "description": "Append-only startup recovery ownership ledger.",
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/RecoveryOwnershipAction" }
        },
        "generated_at": { "type": "string", "format": "date-time" },
        "recovery_run_id": { "type": ["string", "null"] },
        "startup_timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "required": [
        "actions",
        "generated_at",
        "recovery_run_id",
        "startup_timestamp"
      ],
      "additionalProperties": false
    },
    "RecoveryOwnershipAction": {
      "title": "RecoveryOwnershipAction",
      "description": "A single recovery ownership action recorded in the ledger.",
      "type": "object",
      "properties": {
        "delivery_plan_id": { "type": "string" },
        "event_id": { "type": "string" },
        "outbox_id": { "type": "string" },
        "ownership_action": {
          "type": "string",
          "enum": [
            "recoverable",
            "claimed_for_recovery",
            "reclaimed",
            "abandoned",
            "unrecoverable",
            "skipped"
          ]
        },
        "prior_status": { "type": "string" },
        "reason": { "type": "string" },
        "observed_status": { "type": "string" },
        "recovery_run_id": { "type": ["string", "null"] },
        "recovery_source": {
          "type": "string",
          "enum": [
            "startup_recovery",
            "retry_worker_recovery",
            "snapshot_diagnostics",
            "replay_execution"
          ]
        },
        "startup_timestamp": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "timestamp": { "type": "string", "format": "date-time" },
        "worker_identity": { "type": ["string", "null"] }
      },
      "required": [
        "delivery_plan_id",
        "event_id",
        "outbox_id",
        "ownership_action",
        "prior_status",
        "reason",
        "observed_status",
        "recovery_run_id",
        "recovery_source",
        "startup_timestamp",
        "timestamp",
        "worker_identity"
      ],
      "additionalProperties": false
    },
    "LifecycleConvergenceReport": {
      "title": "LifecycleConvergenceReport",
      "description": "Aggregate lifecycle delivery convergence report with receipt/outbox state checks.",
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/LifecycleConvergenceFinding" },
          "description": "Individual lifecycle findings, deterministically sorted by (kind, record_id)."
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of lifecycle findings."
        },
        "severity_counts": {
          "type": "object",
          "properties": {
            "safe": { "type": "integer", "minimum": 0 },
            "degraded": { "type": "integer", "minimum": 0 },
            "inconsistent": { "type": "integer", "minimum": 0 }
          },
          "required": ["safe", "degraded", "inconsistent"],
          "additionalProperties": false,
          "description": "Count of findings per severity level."
        },
        "worst_severity": {
          "type": ["string", "null"],
          "enum": ["safe", "degraded", "inconsistent", null],
          "description": "Worst severity among findings, or null if empty."
        }
      },
      "required": [
        "findings",
        "total_findings",
        "severity_counts",
        "worst_severity"
      ],
      "additionalProperties": false
    },
    "LifecycleConvergenceFinding": {
      "title": "LifecycleConvergenceFinding",
      "description": "A single lifecycle delivery convergence finding (receipt/outbox mismatch, retry anomaly, etc.).",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "receipt_outbox_mismatch",
            "terminal_receipt_nonterminal_outbox",
            "terminal_outbox_nonterminal_receipt",
            "retry_wait_missing_next_retry",
            "next_retry_in_past",
            "retryable_without_retry_metadata",
            "stalled_delivery_plan",
            "attempt_count_regression",
            "receipt_sequence_gap"
          ],
          "description": "Category of lifecycle finding."
        },
        "severity": {
          "type": "string",
          "enum": ["inconsistent", "degraded"],
          "description": "Convergence severity string."
        },
        "record_id": {
          "type": "string",
          "description": "Identifier of the affected record (outbox_id or receipt_id)."
        },
        "record_type": {
          "type": "string",
          "enum": ["outbox", "receipt"],
          "description": "Type of the affected record."
        },
        "details": {
          "type": "string",
          "description": "Human-readable diagnostic message."
        },
        "extra": {
          "type": "object",
          "description": "Additional JSON-safe context (event IDs, plan IDs, statuses).",
          "additionalProperties": true
        }
      },
      "required": [
        "kind",
        "severity",
        "record_id",
        "record_type",
        "details",
        "extra"
      ],
      "additionalProperties": false
    }
  }
}
