{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medre.dev/schemas/radio-text-plan.schema.json",
  "title": "Immutable radio text wire plan",
  "description": "A planned wire snapshot, not delivery authority. Byte counts, digests, ordinal continuity and content reconstruction require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "max_text_bytes", "prefix", "source_sha256", "parts", "fingerprint"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "max_text_bytes": {"type": "integer", "minimum": 1},
    "prefix": {"type": "string", "maxLength": 1048576},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "fingerprint": {"$ref": "#/$defs/digest"},
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/part"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "body", "wire_text", "wire_bytes", "wire_sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 128},
        "body": {"type": "string", "minLength": 1, "maxLength": 1048576},
        "wire_text": {"type": "string", "minLength": 1},
        "wire_bytes": {"type": "integer", "minimum": 1},
        "wire_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
