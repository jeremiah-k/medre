{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jeremiah-k/medre/main/docs/schemas/package-sources.schema.json",
  "title": "MEDRE package sources",
  "description": "Explicit deployment aliases; independent of runtime transport discovery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapters"],
  "properties": {
    "adapters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]"
          }
        ]
      }
    },
    "core": {
      "description": "Optional MEDRE requirement, applied only by explicit upgrade --sync-sources.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[mM][eE][dD][rR][eE](?:\\[|\\s|[<>=!~;@]|$)"
        }
      ]
    }
  }
}
