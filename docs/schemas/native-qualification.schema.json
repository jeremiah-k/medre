{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native qualification test artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "core", "provider", "runtime", "ci", "harnesses", "observation", "ledger_binding", "observer", "record_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "core": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {"revision": {"$ref": "#/$defs/revision"}, "dirty": {"type": "boolean"}}
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["transport", "repository", "revision", "sdk_versions"],
      "properties": {
        "transport": {"enum": ["meshcore", "lxmf"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"$ref": "#/$defs/revision"},
        "sdk_versions": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+$"}, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["python", "platform"],
      "properties": {"python": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}}
    },
    "ci": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "run_attempt"],
      "properties": {"run_id": {"type": ["string", "null"], "pattern": "^[0-9]+$"}, "run_attempt": {"type": ["string", "null"], "pattern": "^[0-9]+$"}}
    },
    "harnesses": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "path", "sha256"],
        "properties": {
          "repository": {"enum": ["core", "provider"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "delivery_plan_id", "target_adapter", "target_channel", "outbox_id", "attempt_number", "receipt_id", "native_message_id", "scope", "tier", "result", "evidence_fingerprint"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "delivery_plan_id": {"type": "string", "minLength": 1},
        "target_adapter": {"type": "string", "minLength": 1},
        "target_channel": {"type": ["string", "null"], "minLength": 1},
        "outbox_id": {"type": "string", "minLength": 1},
        "attempt_number": {"type": "integer", "minimum": 1},
        "receipt_id": {"type": "string", "minLength": 1},
        "native_message_id": {"type": ["string", "null"], "minLength": 1},
        "scope": {"enum": ["provider_acceptance", "recipient_observation"]},
        "tier": {"const": "local_integration"},
        "result": {"const": "accepted"},
        "evidence_fingerprint": {"$ref": "#/$defs/digest"}
      }
    },
    "ledger_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {"state": {"const": "current"}, "reason": {"const": "exact"}}
    },
    "observer": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "count", "witness_sha256"],
      "properties": {
        "kind": {"enum": ["companion_protocol", "recipient_callback"]},
        "count": {"type": "integer", "minimum": 1},
        "witness_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}}
      }
    },
    "record_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
