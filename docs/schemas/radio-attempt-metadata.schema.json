{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jeremiah-k/medre/main/docs/schemas/radio-attempt-metadata.schema.json",
  "title": "Radio attempt metadata without wire content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outbox_id",
    "attempt_number",
    "plan_fingerprint",
    "parts",
    "content_withheld"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "outbox_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "plan_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "state", "handoff_recorded"],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "state": {
            "enum": ["unsent", "submitting", "accepted", "unknown"]
          },
          "handoff_recorded": {
            "type": "boolean"
          }
        }
      }
    },
    "content_withheld": {
      "const": true
    }
  }
}
