{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medre.dev/schemas/routing-config.schema.json",
  "title": "RoutingConfig",
  "description": "Route configuration shapes: RouteConfig, BridgePolicy, RouteRetryConfig, and RouteConfigSet. Derived from frozen dataclasses in config/routes.py.",
  "oneOf": [
    {
      "title": "RouteConfig",
      "description": "A single named route definition.",
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "$comment": "When omitted, the route's mapping key is used as route_id; a route_id key inside the mapping value is ignored.",
          "description": "Unique identifier for this route (alphanumeric, underscores, hyphens)."
        },
        "source_adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Tuple of source adapter IDs."
        },
        "dest_adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Tuple of destination adapter IDs."
        },
        "directionality": {
          "type": "string",
          "enum": ["source_to_dest", "dest_to_source", "bidirectional"],
          "default": "source_to_dest",
          "description": "Direction of event flow."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this route is enabled at startup."
        },
        "source_channel": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional source channel/conversation ID."
        },
        "dest_channel": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional destination channel/conversation ID."
        },
        "source_room": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional source room ID (alias for source_channel)."
        },
        "dest_room": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional destination room ID (alias for dest_channel)."
        },
        "dest_destination": {
          "oneOf": [
            {
              "$ref": "#/$defs/RouteDestination"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional structured destination addressing for the delivery targets (identity/hash form). Mutually exclusive with dest_channel and dest_room: a route target has exactly one addressing authority. Applies to the route's configured dest side only."
        },
        "policy": {
          "oneOf": [
            {
              "$ref": "#/$defs/BridgePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional static bridge policy. Null means no restrictions."
        },
        "retry": {
          "oneOf": [
            {
              "$ref": "#/$defs/RouteRetryConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional per-route retry policy. Null means no retry scheduling."
        },
        "context_map": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[^\\s](.*[^\\s])?$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/ContextMapEntry"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mapping of source-side opaque context strings to structured entries with exactly one of 'dest_context' / 'dest_destination' plus optional 'source_origin_label' / 'dest_origin_label'. Contexts are opaque strings owned by their adapters; no transport-specific syntax is validated here. Mutually exclusive with source_channel/dest_channel/source_room/dest_room. Requires exactly one source and one dest adapter."
        },
        "source_origin_label": {
          "type": ["string", "null"],
          "default": null,
          "description": "Source-side human-readable label for the forward leg of this route (source→dest). When set, takes precedence over the source adapter's origin_label in relay-prefix attribution. Falls back to adapter config origin_label when null. This is source-context metadata, not a routing key or delivery evidence."
        },
        "dest_origin_label": {
          "type": ["string", "null"],
          "default": null,
          "description": "Source-side human-readable label for the reverse leg of this route (dest→source). Same precedence as source_origin_label but applied when direction is swapped during expansion. Falls back to adapter config origin_label when null."
        }
      },
      "required": ["route_id", "source_adapters", "dest_adapters"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "dest_destination": { "type": "object" } },
            "required": ["dest_destination"]
          },
          "then": {
            "properties": {
              "dest_channel": { "type": "null" },
              "dest_room": { "type": "null" },
              "context_map": { "type": "null" },
              "dest_adapters": { "maxItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "context_map": { "type": "object" } },
            "required": ["context_map"]
          },
          "then": {
            "properties": {
              "source_adapters": { "maxItems": 1 },
              "dest_adapters": { "maxItems": 1 },
              "source_channel": { "type": "null" },
              "dest_channel": { "type": "null" },
              "source_room": { "type": "null" },
              "dest_room": { "type": "null" },
              "dest_destination": { "type": "null" }
            }
          }
        }
      ]
    },
    {
      "title": "RouteConfigSet",
      "description": "Ordered, validated collection of RouteConfig instances.",
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteConfigRef"
          },
          "default": [],
          "description": "Ordered tuple of route configurations."
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "RouteDestination": {
      "title": "RouteDestination",
      "description": "Structured destination addressing (routing-delivery spec §2.3). Mirrors RouteDestinationConfig in config/routes.py.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "channel",
            "lxmf_destination",
            "meshcore_contact",
            "matrix_room"
          ],
          "description": "Addressing scheme. 'channel'/'matrix_room' address a logical channel or room by name; 'lxmf_destination' addresses a 32-hex-character LXMF destination hash; 'meshcore_contact' addresses a contact by hash and/or name."
        },
        "destination_hash": {
          "type": ["string", "null"],
          "default": null,
          "description": "Hash-based identifier when applicable for the kind. Required and 32-hex for 'lxmf_destination'; must be null for 'channel'/'matrix_room'.",
          "minLength": 1
        },
        "destination_name": {
          "type": ["string", "null"],
          "default": null,
          "description": "Human-readable name when applicable for the kind. Required for 'channel'/'matrix_room'.",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "default": {},
          "description": "Extensible destination-specific parameters."
        }
      },
      "required": ["kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "lxmf_destination" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "destination_hash": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{32}$"
              }
            },
            "required": ["destination_hash"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["channel", "matrix_room"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "destination_hash": { "type": "null" },
              "destination_name": { "type": "string", "minLength": 1 }
            },
            "required": ["destination_name"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "meshcore_contact" } },
            "required": ["kind"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "destination_hash": { "type": "string", "minLength": 1 }
                },
                "required": ["destination_hash"]
              },
              {
                "properties": {
                  "destination_name": { "type": "string", "minLength": 1 }
                },
                "required": ["destination_name"]
              }
            ]
          }
        }
      ]
    },
    "ContextMapEntry": {
      "title": "ContextMapEntry",
      "description": "A single context_map entry mapping a source-side opaque context to the dest side, with optional per-entry origin labels that override the route-level labels for this entry's expanded legs only.",
      "type": "object",
      "properties": {
        "dest_context": {
          "type": ["string", "null"],
          "minLength": 1,
          "default": null,
          "description": "Opaque dest-side context (e.g. a room, channel, or topic identifier — owned and validated by the dest adapter). Mutually exclusive with dest_destination; exactly one of the two is required."
        },
        "dest_destination": {
          "oneOf": [
            {
              "$ref": "#/$defs/RouteDestination"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured destination entity addressed by this entry. Mutually exclusive with dest_context; exactly one of the two is required. Entries carrying a structured destination expand forward legs only (they require route directionality 'source_to_dest')."
        },
        "source_origin_label": {
          "type": ["string", "null"],
          "default": null,
          "description": "Per-entry forward-leg source label. Null inherits the route-level source_origin_label. An explicit empty string suppresses the adapter-level fallback for this entry's forward leg."
        },
        "dest_origin_label": {
          "type": ["string", "null"],
          "default": null,
          "description": "Per-entry reverse-leg source label. Null inherits the route-level dest_origin_label. An explicit empty string suppresses the adapter-level fallback for this entry's reverse leg."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "dest_context": { "type": "string" } },
            "required": ["dest_context"]
          },
          "then": {
            "properties": { "dest_destination": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "dest_destination": { "type": "object" } },
            "required": ["dest_destination"]
          },
          "then": {
            "properties": { "dest_context": { "type": "null" } }
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "dest_context": { "type": "string", "minLength": 1 }
              },
              "required": ["dest_context"]
            },
            {
              "properties": { "dest_destination": { "type": "object" } },
              "required": ["dest_destination"]
            }
          ]
        }
      ]
    },
    "RouteConfigRef": {
      "title": "RouteConfig",
      "type": "object",
      "properties": {
        "route_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "source_adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dest_adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "directionality": {
          "type": "string",
          "enum": ["source_to_dest", "dest_to_source", "bidirectional"],
          "default": "source_to_dest"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "source_channel": {
          "type": ["string", "null"],
          "default": null
        },
        "dest_channel": {
          "type": ["string", "null"],
          "default": null
        },
        "source_room": {
          "type": ["string", "null"],
          "default": null
        },
        "dest_room": {
          "type": ["string", "null"],
          "default": null
        },
        "dest_destination": {
          "oneOf": [
            {
              "$ref": "#/$defs/RouteDestination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy": {
          "oneOf": [
            {
              "$ref": "#/$defs/BridgePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retry": {
          "oneOf": [
            {
              "$ref": "#/$defs/RouteRetryConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_map": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[^\\s](.*[^\\s])?$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/ContextMapEntry"
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_origin_label": {
          "type": ["string", "null"],
          "default": null
        },
        "dest_origin_label": {
          "type": ["string", "null"],
          "default": null
        }
      },
      "required": ["route_id", "source_adapters", "dest_adapters"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "dest_destination": { "type": "object" } },
            "required": ["dest_destination"]
          },
          "then": {
            "properties": {
              "dest_channel": { "type": "null" },
              "dest_room": { "type": "null" },
              "context_map": { "type": "null" },
              "dest_adapters": { "maxItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "context_map": { "type": "object" } },
            "required": ["context_map"]
          },
          "then": {
            "properties": {
              "source_adapters": { "maxItems": 1 },
              "dest_adapters": { "maxItems": 1 },
              "source_channel": { "type": "null" },
              "dest_channel": { "type": "null" },
              "source_room": { "type": "null" },
              "dest_room": { "type": "null" },
              "dest_destination": { "type": "null" }
            }
          }
        }
      ]
    },
    "BridgePolicy": {
      "title": "BridgePolicy",
      "description": "Static allowlist policy attached to a route. Empty tuples mean 'allow all'.",
      "type": "object",
      "properties": {
        "allowed_event_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Event kinds this policy permits."
        },
        "allowed_source_adapters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Source adapter IDs this policy permits."
        },
        "allowed_dest_adapters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Destination adapter IDs this policy permits."
        },
        "room_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Room IDs the policy permits."
        },
        "channel_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Channel identifiers the policy permits."
        },
        "sender_allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Sender identifiers the policy permits."
        }
      },
      "additionalProperties": false
    },
    "RouteRetryConfig": {
      "title": "RouteRetryConfig",
      "description": "Per-route retry policy for transient delivery failures.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether retry scheduling is active for this route."
        },
        "max_attempts": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Maximum total delivery attempts (including the initial)."
        },
        "backoff_base": {
          "type": "number",
          "default": 2.0,
          "minimum": 0,
          "description": "Base delay in seconds for exponential backoff."
        },
        "max_delay_seconds": {
          "type": "number",
          "default": 60.0,
          "minimum": 0,
          "description": "Upper bound for the computed backoff delay."
        },
        "jitter": {
          "type": "boolean",
          "default": false,
          "description": "Whether to add jitter to the backoff delay."
        }
      },
      "additionalProperties": false
    }
  }
}
