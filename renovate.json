{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "forkProcessing": "enabled",
  "mode": "full",
  "enabledManagers": [
    "pep621",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "custom.regex",
    "asdf"
  ],
  "ignorePaths": [],
  "rangeStrategy": "pin",
  "timezone": "America/Chicago",
  "updateNotScheduled": true,
  "dependencyDashboard": {
    "enabled": true,
    "title": "Dependency Updates (medre)"
  },
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "separateMajorMinor": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "customDatasources": {
    "trunk-cli": {
      "defaultRegistryUrlTemplate": "https://trunk.io/releases/latest",
      "format": "yaml",
      "transformTemplates": ["{\"releases\":[{\"version\": $string(version)}]}"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Synapse integration image across compose, CI workflow, conftest, live starter, bridge artifact env-fallbacks, and runner script",
      "managerFilePatterns": [
        "/(^|/)docker-compose\\.integration\\.yaml$/",
        "/(^|/)\\.github[/]workflows[/]docker-integration\\.yml$/",
        "/(^|/)tests[/]integration[/]conftest\\.py$/",
        "/(^|/)tests[/]helpers[/]synapse_starter\\.py$/",
        "/(^|/)scripts[/]ci[/]docker_bridge_artifacts\\.py$/",
        "/(^|/)scripts[/]ci[/]run-docker-integration\\.sh$/"
      ],
      "matchStrings": [
        "matrixdotorg/synapse:(?<currentValue>[^@\\\"\\)\\s]+)(?:[\"']\\s*[\"'])?(?:@(?<currentDigest>sha256:[0-9a-f]+))?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "matrixdotorg/synapse",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "meshtasticd integration image across compose, CI workflow, conftest, bridge artifact env-fallbacks, runner script, and bridge example config",
      "managerFilePatterns": [
        "/(^|/)docker-compose\\.integration\\.yaml$/",
        "/(^|/)\\.github[/]workflows[/]docker-integration\\.yml$/",
        "/(^|/)tests[/]integration[/]conftest\\.py$/",
        "/(^|/)scripts[/]ci[/]docker_bridge_artifacts\\.py$/",
        "/(^|/)scripts[/]ci[/]run-docker-integration\\.sh$/",
        "/(^|/)examples[/]configs[/]docker-meshtastic-bridge\\.yaml$/"
      ],
      "matchStrings": [
        "meshtastic/meshtasticd:(?<currentValue>[^@\\\"\\)\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]+))?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "meshtastic/meshtasticd",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track medre-adapter-matrix main in the adapter compatibility snapshot",
      "managerFilePatterns": ["/^\\.github/adapter-compatibility\\.json$/"],
      "matchStrings": [
        "\"transport\": \"matrix\",[\\s\\S]*?\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "medre-adapter-matrix",
      "packageNameTemplate": "https://github.com/jeremiah-k/medre-adapter-matrix",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track medre-adapter-meshtastic main in the adapter compatibility snapshot",
      "managerFilePatterns": ["/^\\.github/adapter-compatibility\\.json$/"],
      "matchStrings": [
        "\"transport\": \"meshtastic\",[\\s\\S]*?\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "medre-adapter-meshtastic",
      "packageNameTemplate": "https://github.com/jeremiah-k/medre-adapter-meshtastic",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track medre-adapter-meshcore main in the adapter compatibility snapshot",
      "managerFilePatterns": ["/^\\.github/adapter-compatibility\\.json$/"],
      "matchStrings": [
        "\"transport\": \"meshcore\",[\\s\\S]*?\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "medre-adapter-meshcore",
      "packageNameTemplate": "https://github.com/jeremiah-k/medre-adapter-meshcore",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track medre-adapter-lxmf main in the adapter compatibility snapshot",
      "managerFilePatterns": ["/^\\.github/adapter-compatibility\\.json$/"],
      "matchStrings": [
        "\"transport\": \"lxmf\",[\\s\\S]*?\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "medre-adapter-lxmf",
      "packageNameTemplate": "https://github.com/jeremiah-k/medre-adapter-lxmf",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track medre-adapter-xmpp main in the adapter compatibility snapshot",
      "managerFilePatterns": ["/^\\.github/adapter-compatibility\\.json$/"],
      "matchStrings": [
        "\"transport\": \"xmpp\",[\\s\\S]*?\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "medre-adapter-xmpp",
      "packageNameTemplate": "https://github.com/jeremiah-k/medre-adapter-xmpp",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track medre-adapter-simplexchat main in the adapter compatibility snapshot",
      "managerFilePatterns": ["/^\\.github/adapter-compatibility\\.json$/"],
      "matchStrings": [
        "\"transport\": \"simplexchat\",[\\s\\S]*?\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "medre-adapter-simplexchat",
      "packageNameTemplate": "https://github.com/jeremiah-k/medre-adapter-simplexchat",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track medre-adapter-chatmail main in the adapter compatibility snapshot",
      "managerFilePatterns": ["/^\\.github/adapter-compatibility\\.json$/"],
      "matchStrings": [
        "\"transport\": \"chatmail\",[\\s\\S]*?\"ref\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "medre-adapter-chatmail",
      "packageNameTemplate": "https://github.com/jeremiah-k/medre-adapter-chatmail",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Track Trunk CLI, plugins and linters from their declared upstream package sources",
      "managerFilePatterns": ["/^\\.trunk/trunk\\.yaml$/"],
      "matchStrings": [
        "(?:@|version:\\s+|ref:\\s+v?)(?<currentValue>[0-9][^\\s]*)\\s+# renovate: datasource=(?<datasource>[a-z.-]+) depName=(?<depName>[^\\s]+)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge all non-major dependency updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "automerge": true,
      "minimumReleaseAge": "12 hours"
    },
    {
      "description": "Automerge mtjk updates when new releases are detected",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["mtjk"],
      "automerge": true,
      "minimumReleaseAge": "12 hours"
    },
    {
      "description": "Automerge mindroom-nio updates when new releases are detected",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["mindroom-nio"],
      "automerge": true,
      "minimumReleaseAge": "12 hours"
    },
    {
      "description": "Keep docker integration image refs at their existing pin depth: tag-only fallback defaults stay tag-only",
      "matchPackageNames": ["matrixdotorg/synapse", "meshtastic/meshtasticd"],
      "pinDigests": false
    },
    {
      "description": "requires-python is a deliberate support floor, not a pinnable version: pinning it to one CPython release breaks install on every other supported Python",
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "CI workflow python-version values follow the deliberate test matrix (3.11-3.14, minor-level); do not patch-pin them",
      "matchDepTypes": ["uses-with"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Adapter revision bumps automerge after the cross-adapter compatibility jobs qualify the core/adapter pair on the update PR",
      "matchDepNames": [
        "medre-adapter-matrix",
        "medre-adapter-meshtastic",
        "medre-adapter-meshcore",
        "medre-adapter-lxmf",
        "medre-adapter-xmpp",
        "medre-adapter-simplexchat",
        "medre-adapter-chatmail"
      ],
      "matchUpdateTypes": ["pin", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Adapter revisions requalify as one compatibility set; bundle their bumps into a single medre family PR instead of one PR per adapter",
      "matchDepNames": [
        "medre-adapter-matrix",
        "medre-adapter-meshtastic",
        "medre-adapter-meshcore",
        "medre-adapter-lxmf",
        "medre-adapter-xmpp",
        "medre-adapter-simplexchat",
        "medre-adapter-chatmail"
      ],
      "groupName": "medre family"
    },
    {
      "description": "Trunk tool pins are refreshed by deliberate trunk upgrade rounds, not tracked as dependencies",
      "matchFileNames": [".trunk/trunk.yaml"],
      "enabled": false
    },
    {
      "description": "Review CLI releases from the launcher manifest without a release timestamp",
      "matchDatasources": ["custom.trunk-cli"],
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "Renovate's own tool pin is refreshed with deliberate Trunk toolchain upgrades, not tracked as a dependency",
      "matchDepNames": ["renovate"],
      "enabled": false
    }
  ]
}
